VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ALLOWED_EMAILS=user1@example.com,user2@example.com

# Только npm run dev — автовход без Google (в production-сборке игнорируется)
VITE_DEV_AUTO_LOGIN=false
VITE_DEV_AUTH_EMAIL=user1@example.com
VITE_DEV_AUTH_PASSWORD=
